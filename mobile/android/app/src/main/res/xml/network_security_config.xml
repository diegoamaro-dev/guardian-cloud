<?xml version="1.0" encoding="utf-8"?>
<!--
  Guardian Cloud — Android Network Security Config.

  PURPOSE
    Permit cleartext HTTP only for local LAN / homelab development hosts.
    All other destinations (production backends, Supabase, Google Drive,
    OAuth callbacks) keep platform-default HTTPS-only enforcement, including
    full TLS validation.

  WHY THIS FILE EXISTS
    Android 9+ blocks plaintext HTTP by default. Setting
    `usesCleartextTraffic="true"` on <application> would weaken the WHOLE app
    globally — every domain, every request — which is unacceptable for
    production. This per-domain whitelist keeps the safe default and only
    opens an exception for the documented homelab IPs.

  SCOPE — only these hosts permit HTTP:
    - 192.168.178.79  : LAN backend (homelab dev box)
    - localhost       : in-device loopback (rare, but harmless)
    - 10.0.2.2        : Android emulator's alias for the host machine

  RULES
    - Add a host here ONLY if it is a private/RFC1918/loopback address.
    - NEVER add a public hostname.
    - Production deploys MUST be reachable via HTTPS; do not depend on this
      file in release distribution channels.
-->
<network-security-config>
    <!--
      Base config = the default applied to every destination NOT listed
      below. cleartextTrafficPermitted="false" makes plain HTTP impossible
      app-wide unless an explicit <domain-config> below opts in.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>

    <!--
      Per-domain exception: cleartext HTTP allowed ONLY for these hosts.
      Anything else still requires HTTPS + valid TLS.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.178.79</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>

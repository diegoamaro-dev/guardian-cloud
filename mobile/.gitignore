# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.keystore
*.pepk
*.p8
*.p12
*.key
*.mobileprovision
credentials.json

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
# `.env` is loaded by Metro for local builds (`expo run:android`).
# EAS builds get the same vars from EAS Environment Variables — see
# the `environment` field per profile in `eas.json`. Either way the
# file MUST stay out of git: anon keys / API URLs are not "secret"
# but accidental commits make rotation painful.
.env
.env.local
.env*.local

# typescript
*.tsbuildinfo
